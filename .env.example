# Maison local environment
# Copy this file to `.env`, then replace only the placeholders you need.
# Never commit `.env` or put real secrets in this example file.

# Required for local development
SESSION_SECRET="<random-string>"
PUBLIC_STORE_DOMAIN="<store>.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN="<public-storefront-api-token>"
WEAVERSE_PROJECT_ID="<weaverse-project-id>"

# Shopify storefront, checkout, and customer accounts
# PRIVATE_STOREFRONT_API_TOKEN="<private-storefront-api-token>"
# PUBLIC_STOREFRONT_ID="<hydrogen-storefront-id>"
# PUBLIC_CHECKOUT_DOMAIN="<store-checkout-domain>"
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID="<customer-account-client-id>"
# SHOP_ID="<shop-id>"

# Optional Weaverse configuration
# WEAVERSE_API_KEY="<weaverse-api-key>"
# WEAVERSE_HOST="https://studio.weaverse.io"
# WEAVERSE_API_BASE="https://api.weaverse.io"

# Optional analytics and client-side integrations
# PUBLIC_GOOGLE_GTM_ID is a public container ID and safe in the browser.
# Leave it unset to skip GTM entirely.
# PUBLIC_GOOGLE_GTM_ID="GTM-XXXXXXX"
# PUBLIC_SHOPIFY_INBOX_SHOP_ID="<shopify-inbox-shop-id>"

# Optional server-only integrations
# Never prefix these with PUBLIC_. Set the same names in Oxygen Preview/Production.
# KLAVIYO_PRIVATE_API_TOKEN="<klaviyo-private-api-token>"
# JUDGEME_PRIVATE_API_TOKEN="<judgeme-private-api-token>"
# ALI_REVIEWS_API_KEY="<ali-reviews-api-key>"

# Optional Shopify content configuration
# METAOBJECT_COLORS_TYPE="<shopify-metaobject-type>"
# CUSTOM_COLLECTION_BANNER_METAFIELD="<namespace.key>"

# Reserved for a future headless B2B service. No route reads these yet.
# HEADLESS_B2B_HOST="<headless-b2b-host>"
# HEADLESS_B2B_TOKEN="<headless-b2b-token>"
